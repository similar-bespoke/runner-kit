#!/usr/bin/env zsh
# One client for builders, resumes, reviewers and account checks. Never select
# another executable or model after a failure.
set -u
CONF="${RUNNER_CONF:-$PWD/runner.conf}"
[ ! -f "$CONF" ] || source "${CONF:A}"
CLIENT="${CODEX_BIN:-/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex}"
[[ "${CLIENT:A}" != "${0:A}" ]] || { print -u2 'CODEX_BIN must name the Codex binary, not runner-codex itself.'; exit 2; }
if [[ "$CLIENT" != /* ]] || [ ! -x "$CLIENT" ]; then
  print -u2 'The selected Codex client is unavailable. Set CODEX_BIN to an absolute path to the newer client. No fallback was attempted.'
  exit 2
fi
VERSION="$("$CLIENT" --version 2>/dev/null)" || exit 2
if ! python3 - "$VERSION" <<'PY'
import re, sys
match = re.search(r"\b(\d+)\.(\d+)\.(\d+)", sys.argv[1])
sys.exit(0 if match and tuple(map(int, match.groups())) >= (0, 162, 0) else 1)
PY
then
  print -u2 "Codex 0.162.0 or newer is required; selected client reports: $VERSION. No fallback was attempted."
  exit 2
fi
if [ "${1:-}" = exec ]; then
  pinned=0
  for (( i=2; i<=$#; i++ )); do
    case "${argv[$i]}" in
      -m|--model) [ $i -lt $# ] && [ -n "${argv[$((i+1))]}" ] && pinned=1;;
      --model=?*) pinned=1;;
    esac
  done
  [ "$pinned" = 1 ] || { print -u2 'A Codex task or review requires an explicit pinned model. No default or fallback model was selected.'; exit 2; }
fi
exec "$CLIENT" "$@"
